# Configuración de PostgreSQL
POSTGRES_USER=AQUI_VA_TU_USUARIO
POSTGRES_PASSWORD=AQUI_VA_TU_CONTRASEÑA
POSTGRES_DB=AQUI_VA_EL_NOMBRE_DE_TU_BASE_DE_DATOS
POSTGRES_PORT=5432

# Configuración de pgAdmin
PGADMIN_DEFAULT_EMAIL=AQUI_VA_TU_CORREO
PGADMIN_DEFAULT_PASSWORD=AQUI_VA_TU_CONTRASEÑA
PGADMIN_PORT=8082

# Configuración de SQL Server
ACCEPT_EULA=Y
# Debe tener al menos 8 caracteres e incluir mayúsculas, minúsculas, números y símbolos
MSSQL_SA_PASSWORD=AQUI_VA_TU_CONTRASEÑA
MSSQL_PORT=1433

# Configuración de Neo4j (formato: usuario/contraseña)
NEO4J_AUTH=AQUI_VA_TU_USUARIO/AQUI_VA_TU_CONTRASEÑA
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Configuración de MongoDB
MONGO_INITDB_ROOT_USERNAME=AQUI_VA_TU_USUARIO
MONGO_INITDB_ROOT_PASSWORD=AQUI_VA_TU_CONTRASEÑA
MONGO_PORT=27018

# Red externa de Docker
DOCKER_NETWORK=campuscloud_net

# Volúmenes
POSTGRES_VOLUME=postgres_data
PGADMIN_VOLUME=pgadmin_data
SQLSERVER_VOLUME=campuscloud_sqlserver_data
NEO4J_VOLUME=campuscloud_neo4j_data
MONGO_VOLUME=campuscloud_mongo_data